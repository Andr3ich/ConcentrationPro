<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#EEF6FF</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceSoftColor">#F7FAFF</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>

    <Color x:Key="ShellTitleBarColor">#EEF6FF</Color>
    <Color x:Key="ShellTitleForegroundColor">#0F172A</Color>
    <Color x:Key="ShellWindowButtonForegroundColor">#0F172A</Color>

    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <Color x:Key="BorderColor">#DCE7F5</Color>
    <Color x:Key="BorderSoftColor">#EAF1FB</Color>
    <Color x:Key="DividerColor">#E2E8F0</Color>

    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentSoftColor">#DBEAFE</Color>
    <Color x:Key="AccentUltraSoftColor">#EFF6FF</Color>

    <Color x:Key="ProductiveColor">#22C55E</Color>
    <Color x:Key="NeutralColor">#64748B</Color>
    <Color x:Key="CommunicationColor">#38BDF8</Color>
    <Color x:Key="DistractionColor">#E11D48</Color>
    <Color x:Key="AfkColor">#A855F7</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="ErrorSoftColor">#FEE2E2</Color>

    <Color x:Key="KpiBlueColor">#2563EB</Color>
    <Color x:Key="KpiBlueSoftColor">#DBEAFE</Color>

    <Color x:Key="KpiPurpleColor">#7C3AED</Color>
    <Color x:Key="KpiPurpleSoftColor">#EDE9FE</Color>

    <Color x:Key="KpiOrangeColor">#F97316</Color>
    <Color x:Key="KpiOrangeSoftColor">#FFEDD5</Color>

    <Color x:Key="KpiGreenColor">#16A34A</Color>
    <Color x:Key="KpiGreenSoftColor">#DCFCE7</Color>

    <Color x:Key="ShadowColor">#1F0F172A</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSoftBrush" Color="{StaticResource SurfaceSoftColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>

    <SolidColorBrush x:Key="ShellTitleBarBrush" Color="{StaticResource ShellTitleBarColor}"/>
    <SolidColorBrush x:Key="ShellTitleForegroundBrush" Color="{StaticResource ShellTitleForegroundColor}"/>
    <SolidColorBrush x:Key="ShellWindowButtonForegroundBrush" Color="{StaticResource ShellWindowButtonForegroundColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentUltraSoftBrush" Color="{StaticResource AccentUltraSoftColor}"/>

    <SolidColorBrush x:Key="ProductiveBrush" Color="{StaticResource ProductiveColor}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource NeutralColor}"/>
    <SolidColorBrush x:Key="CommunicationBrush" Color="{StaticResource CommunicationColor}"/>
    <SolidColorBrush x:Key="DistractionBrush" Color="{StaticResource DistractionColor}"/>
    <SolidColorBrush x:Key="AfkBrush" Color="{StaticResource AfkColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}"/>

    <SolidColorBrush x:Key="KpiBlueBrush" Color="{StaticResource KpiBlueColor}"/>
    <SolidColorBrush x:Key="KpiBlueSoftBrush" Color="{StaticResource KpiBlueSoftColor}"/>

    <SolidColorBrush x:Key="KpiPurpleBrush" Color="{StaticResource KpiPurpleColor}"/>
    <SolidColorBrush x:Key="KpiPurpleSoftBrush" Color="{StaticResource KpiPurpleSoftColor}"/>

    <SolidColorBrush x:Key="KpiOrangeBrush" Color="{StaticResource KpiOrangeColor}"/>
    <SolidColorBrush x:Key="KpiOrangeSoftBrush" Color="{StaticResource KpiOrangeSoftColor}"/>

    <SolidColorBrush x:Key="KpiGreenBrush" Color="{StaticResource KpiGreenColor}"/>
    <SolidColorBrush x:Key="KpiGreenSoftBrush" Color="{StaticResource KpiGreenSoftColor}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardColor}"/>

</ResourceDictionary>
