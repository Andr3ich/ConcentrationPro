<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Tray_OpenDashboard">Відкрити дашборд</sys:String>
    <sys:String x:Key="Tray_StartWithWindows">Запускати разом із Windows</sys:String>
    <sys:String x:Key="Tray_Exit">Вийти з ConcentrationPro</sys:String>

    <sys:String x:Key="Tray_StatusFormat">Стан: {0}</sys:String>
    <sys:String x:Key="Tray_SessionTimeFormat">Час сесії: {0}</sys:String>
    <sys:String x:Key="Tray_ScoreFormat">Бал: {0}</sys:String>
    <sys:String x:Key="Tray_TrackedTimeFormat">Відстежений час: {0}</sys:String>
    <sys:String x:Key="Tray_FocusStreakFormat">Серія фокусу: {0}</sys:String>
    <sys:String x:Key="Tray_ProductiveTimeFormat">Продуктивний час: {0}</sys:String>

    <sys:String x:Key="Tray_ActiveShort">Активно</sys:String>
    <sys:String x:Key="Tray_PausedShort">Пауза</sys:String>
    <sys:String x:Key="Tray_TooltipFormat">ConcentrationPro | {0} | Бал {1}</sys:String>

    <sys:String x:Key="Tray_BalloonStillRunningTitle">ConcentrationPro продовжує працювати</sys:String>
    <sys:String x:Key="Tray_BalloonStillRunningText">Вікно згорнуто в системний трей. Моніторинг триває у фоновому режимі. Двічі клацніть піктограму в треї, щоб повернутися до дашборду.</sys:String>

    <sys:String x:Key="Tray_StartupEnabledText">Автозапуск увімкнено. Програма відкриватиметься згорнутою в трей.</sys:String>
    <sys:String x:Key="Tray_StartupDisabledText">Автозапуск вимкнено.</sys:String>
    <sys:String x:Key="Tray_StartupChangeFailedText">Не вдалося змінити налаштування автозапуску Windows.</sys:String>

</ResourceDictionary>
