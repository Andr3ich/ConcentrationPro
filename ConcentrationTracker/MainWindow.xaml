<metro:MetroWindow x:Class="ConcentrationTracker.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
                   xmlns:controls="clr-namespace:ConcentrationTracker.MVVM.View.Controls"
                   xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                   Title=""
                   Icon="/Resources/Brand/AppIcon.ico"
                   Height="1120"
                   Width="1800"
                   MinHeight="1000"
                   MinWidth="1500"
                   WindowStartupLocation="CenterScreen"
                   Background="{DynamicResource BackgroundBrush}"
                   GlowBrush="{DynamicResource AccentBrush}"
                   WindowTitleBrush="{DynamicResource BackgroundBrush}"
                   NonActiveWindowTitleBrush="{DynamicResource BackgroundBrush}"
                   TitleForeground="{DynamicResource ShellTitleForegroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   ShowTitleBar="False"
                   ShowIconOnTitleBar="False"
                   ShowMinButton="False"
                   ShowMaxRestoreButton="False"
                   ShowCloseButton="False"
                   WindowStyle="None"
                   ResizeMode="CanResize"
                   TitleCharacterCasing="Normal">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="{DynamicResource BackgroundColor}"
                              Offset="0"/>
                <GradientStop Color="{DynamicResource SurfaceSoftColor}"
                              Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:WindowCaptionBar Grid.Row="0"/>

        <Grid Grid.Row="1"
              Margin="26,18,26,26">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="56"
                            Height="56"
                            CornerRadius="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,16,0">

                        <Image Source="/Resources/Brand/AppIcon.png"
                               Width="56"
                               Height="56"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="{DynamicResource App_Title}"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Text="{DynamicResource App_Subtitle}"
                                   FontSize="14"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <controls:HeaderActionsPanel VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

            <controls:MonitoringControlsPanel Grid.Row="2"/>

            <UniformGrid Grid.Row="4"
                         Columns="4">

                <controls:KpiCard Title="{DynamicResource Header_SessionTime}"
                                  Value="{Binding SessionTime}"
                                  IconKind="ClockOutline"
                                  IconBrush="{DynamicResource KpiBlueBrush}"
                                  IconBackground="{DynamicResource KpiBlueSoftBrush}"/>

                <controls:KpiCard Title="{DynamicResource Kpi_TotalSwitches}"
                                  Value="{Binding TotalSwitches}"
                                  IconKind="SwapHorizontal"
                                  IconBrush="{DynamicResource KpiPurpleBrush}"
                                  IconBackground="{DynamicResource KpiPurpleSoftBrush}"/>

                <controls:KpiCard Title="{DynamicResource Kpi_FocusStreak}"
                                  Value="{Binding FocusStreak}"
                                  IconKind="Fire"
                                  IconBrush="{DynamicResource KpiOrangeBrush}"
                                  IconBackground="{DynamicResource KpiOrangeSoftBrush}"/>

                <controls:KpiCard Title="{DynamicResource Kpi_ProductiveTime}"
                                  Value="{Binding ProductiveTime}"
                                  IconKind="Percent"
                                  IconBrush="{DynamicResource KpiGreenBrush}"
                                  IconBackground="{DynamicResource KpiGreenSoftBrush}"/>

            </UniformGrid>

            <Grid Grid.Row="6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:FocusPanel Grid.Column="0"/>

                <controls:DashboardPanel Grid.Column="2"/>

            </Grid>

        </Grid>

    </Grid>

</metro:MetroWindow>
