<Window x:Class="ConcentrationTracker.MVVM.View.Windows.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="296"
        WindowStartupLocation="Manual"
        Deactivated="TrayFlyoutWindow_Deactivated"
        KeyDown="TrayFlyoutWindow_KeyDown">

    <Window.Resources>

        <Style x:Key="TrayMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentUltraSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayStatRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <Style x:Key="TraySeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Margin" Value="8,8"/>
        </Style>

        <Style x:Key="TrayMenuItemTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="8">

        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                              BlurRadius="26"
                              ShadowDepth="6"
                              Opacity="0.20"/>
        </Border.Effect>

        <StackPanel>

            <StackPanel Style="{StaticResource TrayStatRowStyle}">
                <iconPacks:PackIconMaterial Kind="InformationOutline"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource KpiBlueBrush}"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0"/>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Style="{StaticResource TrayStatRowStyle}">
                <iconPacks:PackIconMaterial Kind="TimerSand"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource KpiGreenBrush}"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0"/>
                <TextBlock x:Name="SessionTimeText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Style="{StaticResource TrayStatRowStyle}">
                <iconPacks:PackIconMaterial Kind="Gauge"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource KpiGreenBrush}"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0"/>
                <TextBlock x:Name="ScoreText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Style="{StaticResource TrayStatRowStyle}">
                <iconPacks:PackIconMaterial Kind="ClockOutline"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource KpiBlueBrush}"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0"/>
                <TextBlock x:Name="TrackedTimeText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Style="{StaticResource TrayStatRowStyle}">
                <iconPacks:PackIconMaterial Kind="Fire"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource KpiOrangeBrush}"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0"/>
                <TextBlock x:Name="FocusStreakText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Style="{StaticResource TrayStatRowStyle}"
                        Margin="10,5,10,8">
                <iconPacks:PackIconMaterial Kind="Percent"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource KpiPurpleBrush}"
                                            VerticalAlignment="Center"
                                            Margin="2,0,10,0"/>
                <TextBlock x:Name="ProductiveTimeText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Style="{StaticResource TraySeparatorStyle}"/>

            <Button x:Name="OpenDashboardButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OpenDashboardButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Application"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                    <TextBlock x:Name="OpenDashboardButtonText"
                               Style="{StaticResource TrayMenuItemTextStyle}"/>
                </StackPanel>
            </Button>

            <Button x:Name="SettingsButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CogOutline"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                    <TextBlock x:Name="SettingsButtonText"
                               Style="{StaticResource TrayMenuItemTextStyle}"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource TraySeparatorStyle}"/>

            <Button x:Name="StartMonitoringButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="StartMonitoringButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Play"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource KpiGreenBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                    <TextBlock x:Name="StartMonitoringButtonText"
                               Style="{StaticResource TrayMenuItemTextStyle}"/>
                </StackPanel>
            </Button>

            <Button x:Name="PauseMonitoringButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="PauseMonitoringButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Pause"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource KpiOrangeBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                    <TextBlock x:Name="PauseMonitoringButtonText"
                               Style="{StaticResource TrayMenuItemTextStyle}"/>
                </StackPanel>
            </Button>

            <Button x:Name="ResetSessionButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="ResetSessionButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                    <TextBlock x:Name="ResetSessionButtonText"
                               Style="{StaticResource TrayMenuItemTextStyle}"/>
                </StackPanel>
            </Button>

            <Border Style="{StaticResource TraySeparatorStyle}"/>

            <Button x:Name="StartWithWindowsButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="StartWithWindowsButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Kind="RocketLaunchOutline"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1"
                               x:Name="StartWithWindowsButtonText"
                               Style="{StaticResource TrayMenuItemTextStyle}"/>

                    <iconPacks:PackIconMaterial x:Name="StartWithWindowsCheckIcon"
                                                Grid.Column="2"
                                                Kind="CheckCircleOutline"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                </Grid>
            </Button>

            <Border Style="{StaticResource TraySeparatorStyle}"/>

            <Button x:Name="ExitButton"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="ExitButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"/>
                    <TextBlock x:Name="ExitButtonText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ErrorBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </StackPanel>

    </Border>

</Window>