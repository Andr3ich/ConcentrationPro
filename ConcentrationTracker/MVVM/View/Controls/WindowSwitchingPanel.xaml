<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.WindowSwitchingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="{DynamicResource Charts_WindowSwitchingTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>

                <TextBlock Text="{DynamicResource WindowSwitchingPanel_Subtitle}"
                           FontSize="14"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}"/>

            </StackPanel>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Common_Switches}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">

                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.RenderTransform>

                </TextBlock>

                <Grid Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0"
                             Stretch="Fill">

                        <Canvas Width="1000"
                                Height="250">

                            <Line X1="0" Y1="25" X2="1000" Y2="25"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="0" Y1="80" X2="1000" Y2="80"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="0" Y1="135" X2="1000" Y2="135"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="0" Y1="190" X2="1000" Y2="190"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="0" Y1="240" X2="1000" Y2="240"
                                  Stroke="#94A3B8"
                                  StrokeThickness="1"/>

                            <Line X1="70" Y1="0" X2="70" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="140" Y1="0" X2="140" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="210" Y1="0" X2="210" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="280" Y1="0" X2="280" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="350" Y1="0" X2="350" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="420" Y1="0" X2="420" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="490" Y1="0" X2="490" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="560" Y1="0" X2="560" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="630" Y1="0" X2="630" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="700" Y1="0" X2="700" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="770" Y1="0" X2="770" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="840" Y1="0" X2="840" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Line X1="910" Y1="0" X2="910" Y2="240"
                                  Stroke="#E5EAF2"
                                  StrokeThickness="1"
                                  StrokeDashArray="4 4"/>

                            <Rectangle Canvas.Left="30" Canvas.Top="160" Width="36" Height="80"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="95" Canvas.Top="120" Width="36" Height="120"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="160" Canvas.Top="90" Width="36" Height="150"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="225" Canvas.Top="140" Width="36" Height="100"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="290" Canvas.Top="70" Width="36" Height="170"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="355" Canvas.Top="125" Width="36" Height="115"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="420" Canvas.Top="150" Width="36" Height="90"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="485" Canvas.Top="100" Width="36" Height="140"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="550" Canvas.Top="50" Width="36" Height="190"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="615" Canvas.Top="80" Width="36" Height="160"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="680" Canvas.Top="65" Width="36" Height="175"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="745" Canvas.Top="150" Width="36" Height="90"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="810" Canvas.Top="50" Width="36" Height="190"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                            <Rectangle Canvas.Left="875" Canvas.Top="105" Width="36" Height="135"
                                       RadiusX="7" RadiusY="7" Fill="{StaticResource AccentBlue}"/>

                        </Canvas>

                    </Viewbox>

                    <UniformGrid Grid.Row="1"
                                 Columns="14">

                        <TextBlock Text="00:00" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:05" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:10" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:15" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:20" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:25" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:30" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:35" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:40" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:45" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:50" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="00:55" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="01:00" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="01:05" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>

                    </UniformGrid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Rectangle Width="14"
                                   Height="14"
                                   Fill="{StaticResource AccentBlue}"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="{DynamicResource WindowSwitchingPanel_LegendSwitches}"
                                   FontSize="14"
                                   Foreground="{StaticResource AccentBlue}"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,14">

            <TextBlock Text="{DynamicResource Charts_ScoreTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>

            <TextBlock Text="{DynamicResource WindowSwitchingPanel_ScoreSubtitle}"
                       FontSize="14"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondary}"/>

        </StackPanel>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Score (%)"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">

                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </TextBlock.RenderTransform>

            </TextBlock>

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <Viewbox Grid.Row="0"
                         Stretch="Fill">

                    <Canvas Width="1000"
                            Height="250">

                        <Line X1="0" Y1="25" X2="1000" Y2="25"
                              Stroke="#E5EAF2"
                              StrokeThickness="1"
                              StrokeDashArray="4 4"/>

                        <Line X1="0" Y1="90" X2="1000" Y2="90"
                              Stroke="#E5EAF2"
                              StrokeThickness="1"
                              StrokeDashArray="4 4"/>

                        <Line X1="0" Y1="155" X2="1000" Y2="155"
                              Stroke="#E5EAF2"
                              StrokeThickness="1"
                              StrokeDashArray="4 4"/>

                        <Line X1="0" Y1="240" X2="1000" Y2="240"
                              Stroke="#94A3B8"
                              StrokeThickness="1"/>

                        <Polyline Stroke="#10B981"
                                  StrokeThickness="3"
                                  Points="20,80 90,105 160,130 230,100 300,155 370,95 440,90 510,145 580,170 650,160 720,70 790,170 860,170 930,125"/>

                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="15" Canvas.Top="75"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="85" Canvas.Top="100"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="155" Canvas.Top="125"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="225" Canvas.Top="95"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="295" Canvas.Top="150"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="365" Canvas.Top="90"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="435" Canvas.Top="85"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="505" Canvas.Top="140"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="575" Canvas.Top="165"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="645" Canvas.Top="155"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="715" Canvas.Top="65"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="785" Canvas.Top="165"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="855" Canvas.Top="165"/>
                        <Ellipse Width="11" Height="11" Fill="#10B981" Canvas.Left="925" Canvas.Top="120"/>

                    </Canvas>

                </Viewbox>

                <UniformGrid Grid.Row="1"
                             Columns="14">

                    <TextBlock Text="00:00" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:05" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:10" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:15" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:20" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:25" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:30" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:35" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:40" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:45" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:50" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="00:55" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="01:00" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="01:05" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>

                </UniformGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="#10B981"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="{DynamicResource Focus_Title}"
                               FontSize="14"
                               Foreground="#10B981"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
