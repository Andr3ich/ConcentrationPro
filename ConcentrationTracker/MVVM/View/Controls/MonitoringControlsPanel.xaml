<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.MonitoringControlsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="18">

        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                              BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.10"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Command="{Binding StartMonitoringCommand}"
                    MinWidth="156"
                    Margin="0,0,10,0">

                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Play"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextOnAccentBrush}"/>

                    <TextBlock Text="{DynamicResource Monitoring_Start}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button.Visibility>
                    <Binding Path="IsMonitoringPaused"
                             Converter="{StaticResource BoolToVisibilityConverter}"/>
                </Button.Visibility>

            </Button>

            <Button Grid.Column="0"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Command="{Binding PauseMonitoringCommand}"
                    MinWidth="156"
                    Margin="0,0,10,0">

                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Pause"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextOnAccentBrush}"/>

                    <TextBlock Text="{DynamicResource Monitoring_Pause}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button.Visibility>
                    <Binding Path="IsMonitoring"
                             Converter="{StaticResource BoolToVisibilityConverter}"/>
                </Button.Visibility>

            </Button>

            <Button Grid.Column="1"
                    Style="{StaticResource AppSecondaryButtonStyle}"
                    Command="{Binding ResetSessionCommand}"
                    MinWidth="142">

                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="{DynamicResource Monitoring_Reset}"
                               VerticalAlignment="Center"/>
                </StackPanel>

            </Button>

            <Border Grid.Column="3"
                    Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,9"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <iconPacks:PackIconMaterial Kind="CircleMedium"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentBrush}"/>

                    <TextBlock Text="{Binding MonitoringStatus}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>
