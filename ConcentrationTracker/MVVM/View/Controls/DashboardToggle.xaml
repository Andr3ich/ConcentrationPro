<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.DashboardToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="DashboardToggleButtonBaseStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceSoftBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="5"
            Height="56">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding ShowChartsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DashboardToggleButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChartsMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{DynamicResource Tab_Charts}"/>
            </Button>

            <Button Grid.Column="1"
                    Command="{Binding ShowTimelineCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DashboardToggleButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimelineMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{DynamicResource Tab_Timeline}"/>
            </Button>

            <Button Grid.Column="2"
                    Command="{Binding ShowSummaryCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DashboardToggleButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummaryMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{DynamicResource Tab_Summary}"/>
            </Button>

            <Button Grid.Column="3"
                    Command="{Binding ShowCategoriesCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DashboardToggleButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCategoriesMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{DynamicResource Tab_Categories}"/>
            </Button>

            <Button Grid.Column="4"
                    Command="{Binding ShowHistoryCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DashboardToggleButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{DynamicResource Tab_History}"/>
            </Button>

        </Grid>

    </Border>

</UserControl>
