<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.ActivityTimelinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ConcentrationTracker.Core.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>

        <converters:CategoryDisplayNameConverter x:Key="CategoryDisplayNameConverter"/>

        <converters:ActivityIconResolverConverter
            x:Key="ActivityIconResolverConverter"/>

        <converters:AppCategoryToIconGlyphConverter
            x:Key="AppCategoryToIconGlyphConverter"/>

        <converters:AppCategoryToBrushConverter
            x:Key="AppCategoryToBrushConverter"/>

        <converters:AppNameDisplayConverter
            x:Key="AppNameDisplayConverter"/>

        <converters:WindowTitleCleanerConverter
            x:Key="WindowTitleCleanerConverter"/>

        <converters:DurationTextLocalizationConverter x:Key="DurationTextLocalizationConverter"/>

        <converters:StatusTextLocalizationConverter x:Key="StatusTextLocalizationConverter"/>

        <converters:LocalizedFormatConverter x:Key="LocalizedFormatConverter"/>

        <converters:PositiveNumberToVisibilityConverter x:Key="PositiveNumberToVisibilityConverter"/>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="{DynamicResource Timeline_Title}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="{DynamicResource Timeline_Subtitle}"
                           FontSize="13"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12,7"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <iconPacks:PackIconMaterial Kind="TimelineClockOutline"
                                                Width="16"
                                                Height="16"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,7,0"/>

                    <TextBlock Text="{DynamicResource Timeline_LiveFeed}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="14">

            <Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding VisibleActivityEvents.Count, Converter={StaticResource PositiveNumberToVisibilityConverter}}">

                    <ItemsControl ItemsSource="{Binding VisibleActivityEvents}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="16"
                                    Margin="0,0,0,12">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="50"
                                            Height="50"
                                            CornerRadius="16"
                                            Background="{DynamicResource AccentUltraSoftBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top">

                                            <Grid>

                                                <Image Width="30"
                                                   Height="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform">

                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}">
                                                            <Binding Path="AppName"/>
                                                            <Binding Path="WindowTitle"/>
                                                            <Binding Path="ProcessPath"/>
                                                            <Binding Path="PackageInstallPath"/>
                                                            <Binding Path="AppUserModelId"/>
                                                            <Binding Path="PackageFullName"/>
                                                        </MultiBinding>
                                                    </Image.Source>

                                                    <Image.Visibility>
                                                        <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}"
                                                                  ConverterParameter="HasIcon">
                                                            <Binding Path="AppName"/>
                                                            <Binding Path="WindowTitle"/>
                                                            <Binding Path="ProcessPath"/>
                                                            <Binding Path="PackageInstallPath"/>
                                                            <Binding Path="AppUserModelId"/>
                                                            <Binding Path="PackageFullName"/>
                                                        </MultiBinding>
                                                    </Image.Visibility>

                                                </Image>

                                                <TextBlock Text="{Binding Category,
                                                                      Converter={StaticResource AppCategoryToIconGlyphConverter}}"
                                                       FontSize="20"
                                                       FontFamily="Segoe UI Emoji, Segoe UI"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Category,
                                                                            Converter={StaticResource AppCategoryToBrushConverter}}">

                                                    <TextBlock.Visibility>
                                                        <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}"
                                                                  ConverterParameter="NoIcon">
                                                            <Binding Path="AppName"/>
                                                            <Binding Path="WindowTitle"/>
                                                            <Binding Path="ProcessPath"/>
                                                            <Binding Path="PackageInstallPath"/>
                                                            <Binding Path="AppUserModelId"/>
                                                            <Binding Path="PackageFullName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Visibility>

                                                </TextBlock>

                                            </Grid>

                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">

                                            <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding AppName,
                                                                      Converter={StaticResource AppNameDisplayConverter}}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="420"
                                                       ToolTip="{Binding AppName, Converter={StaticResource AppNameDisplayConverter}}"/>

                                                <Border Background="{DynamicResource SurfaceSoftBrush}"
                                                    BorderBrush="{Binding Category,
                                                                          Converter={StaticResource AppCategoryToBrushConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    Margin="10,0,0,0">

                                                    <TextBlock Text="{Binding Category, Converter={StaticResource CategoryDisplayNameConverter}}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Category,
                                                                                Converter={StaticResource AppCategoryToBrushConverter}}"/>

                                                </Border>

                                            </StackPanel>

                                            <TextBlock FontSize="13"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   FontFamily="Segoe UI Emoji, Segoe UI">

                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource WindowTitleCleanerConverter}">
                                                        <Binding Path="WindowTitle"/>
                                                        <Binding Path="AppName"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>

                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0">

                                                <iconPacks:PackIconMaterial Kind="ClockOutline"
                                                                        Width="14"
                                                                        Height="14"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,5,0"/>

                                                <TextBlock Text="{Binding TimeRangeText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                                <TextBlock Text="  •  "
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding StatusText, Converter={StaticResource StatusTextLocalizationConverter}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </StackPanel>

                                        <Border Grid.Column="4"
                                            Background="{DynamicResource SurfaceSoftBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,8"
                                            MinWidth="88"
                                            VerticalAlignment="Center">

                                            <StackPanel>

                                                <TextBlock Text="{DynamicResource Timeline_Duration}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>

                                                <TextBlock Text="{Binding DurationText, Converter={StaticResource DurationTextLocalizationConverter}}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding VisibleActivityEvents.Count, Converter={StaticResource PositiveNumberToVisibilityConverter}, ConverterParameter=Invert}">

                    <iconPacks:PackIconMaterial Kind="TimelineClockOutline"
                                            Width="42"
                                            Height="42"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            HorizontalAlignment="Center"/>

                    <TextBlock Text="{DynamicResource Timeline_EmptyTitle}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="{DynamicResource Timeline_EmptySubtitle}"
                           FontSize="13"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="320"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>