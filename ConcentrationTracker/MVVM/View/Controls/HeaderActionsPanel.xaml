<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.HeaderActionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             MinWidth="208"
             Height="44">

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

        <Button x:Name="SettingsButton"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="{DynamicResource Tooltip_OpenSettings}"
                Margin="0,0,10,0"
                Click="SettingsButton_Click">

            <iconPacks:PackIconMaterial Kind="Cog"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

        </Button>

        <Button x:Name="LanguageButton"
                Style="{StaticResource HeaderPillButtonStyle}"
                ToolTip="{DynamicResource Tooltip_SwitchLanguage}"
                Margin="0,0,10,0"
                Click="LanguageButton_Click">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <iconPacks:PackIconMaterial Kind="Translate"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,7,0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            VerticalAlignment="Center"/>

                <TextBlock x:Name="LanguageText"
                           Text="UA"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Button>

        <Button x:Name="ThemeButton"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTip="{DynamicResource Tooltip_SwitchTheme}"
                Click="ThemeButton_Click">

            <iconPacks:PackIconMaterial x:Name="ThemeIcon"
                                        Kind="WeatherNight"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

        </Button>

    </StackPanel>

</UserControl>
