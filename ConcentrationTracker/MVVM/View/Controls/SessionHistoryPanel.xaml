<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.SessionHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ConcentrationTracker.MVVM.View.Controls"
             xmlns:converters="clr-namespace:ConcentrationTracker.Core.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>

        <converters:StatusTextLocalizationConverter x:Key="StatusTextLocalizationConverter"/>

        <converters:DurationTextLocalizationConverter x:Key="DurationTextLocalizationConverter"/>

        <converters:SwitchesTextLocalizationConverter x:Key="SwitchesTextLocalizationConverter"/>

        <converters:LocalizedFormatConverter x:Key="LocalizedFormatConverter"/>

        <converters:ScoreTierConverter x:Key="ScoreTierConverter"/>

        <Style x:Key="JournalTopButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppSecondaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="JournalTopPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppPrimaryButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="JournalSmallButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AppSecondaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HistoryDeleteButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Background"
                                        Value="{DynamicResource ErrorSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryRowStyle"
               TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="2,14"/>
        </Style>

        <Style x:Key="ScoreBadgeStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource KpiGreenSoftBrush}"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConcentrationScore, Converter={StaticResource ScoreTierConverter}}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource KpiBlueSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConcentrationScore, Converter={StaticResource ScoreTierConverter}}" Value="2">
                    <Setter Property="Background" Value="{DynamicResource KpiOrangeSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConcentrationScore, Converter={StaticResource ScoreTierConverter}}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScoreBadgeTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KpiGreenBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConcentrationScore, Converter={StaticResource ScoreTierConverter}}" Value="1">
                    <Setter Property="Foreground" Value="{DynamicResource KpiBlueBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConcentrationScore, Converter={StaticResource ScoreTierConverter}}" Value="2">
                    <Setter Property="Foreground" Value="{DynamicResource KpiOrangeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConcentrationScore, Converter={StaticResource ScoreTierConverter}}" Value="3">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JournalCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="MiniMetricCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="MetricLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MetricValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SessionLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SessionValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="50"
                    Height="50"
                    CornerRadius="16"
                    Background="{DynamicResource AccentUltraSoftBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1">

                <iconPacks:PackIconMaterial Kind="NotebookOutline"
                                            Width="24"
                                            Height="24"
                                            Foreground="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">

                <TextBlock Text="{DynamicResource History_Title}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="{DynamicResource History_Subtitle}"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

            </StackPanel>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Button Style="{StaticResource JournalTopPrimaryButtonStyle}"
                        Command="{Binding SaveCurrentSessionCommand}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ContentSave"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,7,0"
                                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common_Save}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource JournalTopButtonStyle}"
                        Command="{Binding ReloadSessionHistoryCommand}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Refresh"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,7,0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common_Reload}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource JournalTopButtonStyle}"
                        Command="{Binding ClearSessionHistoryCommand}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Broom"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,7,0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common_Clear}"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource JournalCardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <iconPacks:PackIconMaterial Kind="FormatListBulleted"
                                                    Width="22"
                                                    Height="22"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">

                            <TextBlock Text="{DynamicResource History_ArchiveTitle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="{DynamicResource History_ArchiveSubtitle}"
                                       FontSize="12"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                        </StackPanel>

                        <Border Grid.Column="3"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="12,7">

                            <TextBlock Text="{Binding SessionHistoryStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="230"/>

                        </Border>

                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">

                        <ItemsControl ItemsSource="{Binding SessionHistory}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Style="{StaticResource HistoryRowStyle}">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="1.05*"/>
                                                <ColumnDefinition Width="1.48*"/>
                                                <ColumnDefinition Width="222"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="52"
                                                    Height="52"
                                                    Style="{StaticResource ScoreBadgeStyle}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">

                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScoreText}"
                                                               Style="{StaticResource ScoreBadgeTextStyle}"/>
                                                    <TextBlock Text="{DynamicResource Common_ScoreLower}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>

                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,16,0">

                                                <TextBlock Text="{Binding StartedAtText}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="{Binding BestFocusBlockText, Converter={StaticResource LocalizedFormatConverter}, ConverterParameter=History_BestFocusFormat}"
                                                           FontSize="11"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                            <UniformGrid Grid.Column="2"
                                                         Columns="2"
                                                         Rows="2"
                                                         VerticalAlignment="Center">

                                                <StackPanel Margin="0,0,16,6">
                                                    <TextBlock Text="{DynamicResource History_LabelDuration}"
                                                               Style="{StaticResource SessionLabelStyle}"
                                                               ToolTip="{DynamicResource History_LabelDuration}"/>
                                                    <TextBlock Text="{Binding SessionDurationText, Converter={StaticResource DurationTextLocalizationConverter}}"
                                                               Style="{StaticResource SessionValueStyle}"
                                                               ToolTip="{Binding SessionDurationText, Converter={StaticResource DurationTextLocalizationConverter}}"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{DynamicResource History_LabelProductive}"
                                                               Style="{StaticResource SessionLabelStyle}"
                                                               ToolTip="{DynamicResource History_LabelProductive}"/>
                                                    <TextBlock Text="{Binding ProductiveDurationText, Converter={StaticResource DurationTextLocalizationConverter}}"
                                                               Style="{StaticResource SessionValueStyle}"
                                                               ToolTip="{Binding ProductiveDurationText, Converter={StaticResource DurationTextLocalizationConverter}}"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{DynamicResource History_LabelDistraction}"
                                                               Style="{StaticResource SessionLabelStyle}"
                                                               ToolTip="{DynamicResource History_LabelDistraction}"/>
                                                    <TextBlock Text="{Binding DistractionDurationText, Converter={StaticResource DurationTextLocalizationConverter}}"
                                                               Style="{StaticResource SessionValueStyle}"
                                                               ToolTip="{Binding DistractionDurationText, Converter={StaticResource DurationTextLocalizationConverter}}"/>
                                                </StackPanel>

                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource History_LabelSwitches}"
                                                               Style="{StaticResource SessionLabelStyle}"
                                                               ToolTip="{DynamicResource History_LabelSwitches}"/>
                                                    <TextBlock Text="{Binding SwitchesText, Converter={StaticResource SwitchesTextLocalizationConverter}}"
                                                               Style="{StaticResource SessionValueStyle}"
                                                               ToolTip="{Binding SwitchesText, Converter={StaticResource SwitchesTextLocalizationConverter}}"/>
                                                </StackPanel>

                                            </UniformGrid>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">

                                                <Button Style="{StaticResource JournalSmallButtonStyle}"
                                                        Command="{Binding DataContext.OpenSessionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0">

                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center">
                                                        <iconPacks:PackIconMaterial Kind="OpenInNew"
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Margin="0,0,5,0"
                                                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                    VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource History_OpenDetails}"/>
                                                    </StackPanel>

                                                </Button>

                                                <Button Style="{StaticResource HistoryDeleteButtonStyle}"
                                                        ToolTip="{DynamicResource Common_Delete}"
                                                        Command="{Binding DataContext.DeleteSessionRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">

                                                    <iconPacks:PackIconMaterial Kind="DeleteOutline"
                                                                                Width="16"
                                                                                Height="16"
                                                                                Foreground="{DynamicResource ErrorBrush}"/>

                                                </Button>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0"
                             Columns="2"
                             Rows="2">

                    <Border Style="{StaticResource MiniMetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="12"
                                    Background="{DynamicResource KpiBlueSoftBrush}">
                                <iconPacks:PackIconMaterial Kind="ArchiveOutline"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{DynamicResource KpiBlueBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource History_Sessions}"
                                           Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="{Binding SavedSessionsCount}"
                                           Style="{StaticResource MetricValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="12"
                                    Background="{DynamicResource KpiGreenSoftBrush}">
                                <iconPacks:PackIconMaterial Kind="Gauge"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{DynamicResource KpiGreenBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource History_Average}"
                                           Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="{Binding AverageSavedScore}"
                                           Style="{StaticResource MetricValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MiniMetricCardStyle}"
                            Margin="0,0,9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="12"
                                    Background="{DynamicResource KpiOrangeSoftBrush}">
                                <iconPacks:PackIconMaterial Kind="TrophyOutline"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{DynamicResource KpiOrangeBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource History_Best}"
                                           Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="{Binding BestSavedScore}"
                                           Style="{StaticResource MetricValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="12"
                                    Background="{DynamicResource KpiPurpleSoftBrush}">
                                <iconPacks:PackIconMaterial Kind="ClockCheckOutline"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{DynamicResource KpiPurpleBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource History_Last}"
                                           Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="{Binding LastSavedSessionText}"
                                           Style="{StaticResource MetricValueStyle}"
                                           FontSize="14"
                                           ToolTip="{Binding LastSavedSessionText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </UniformGrid>

                <Border Grid.Row="2"
                        Style="{StaticResource JournalCardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">

                            <iconPacks:PackIconMaterial Kind="TrendingUp"
                                                        Width="21"
                                                        Height="21"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Margin="0,0,9,0"
                                                        VerticalAlignment="Center"/>

                            <StackPanel>
                                <TextBlock Text="{DynamicResource History_ScoreTrend}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <TextBlock Text="{DynamicResource History_ScoreTrendSubtitle}"
                                           FontSize="11"
                                           Margin="0,1,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                        </StackPanel>

                        <controls:ThemedPlotView Grid.Row="2"
                                                  Model="{Binding HistoryScoreTrendPlotModel, Mode=OneWay}"
                                                  Background="Transparent"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <Grid Grid.Row="3"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <iconPacks:PackIconMaterial Kind="DatabaseCheckOutline"
                                        Width="15"
                                        Height="15"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="{DynamicResource History_StorageNote}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</UserControl>