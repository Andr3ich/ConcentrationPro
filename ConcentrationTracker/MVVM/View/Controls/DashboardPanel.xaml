<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.DashboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ConcentrationTracker.MVVM.View.Controls">

    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="24"
            Padding="24"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                              BlurRadius="22"
                              ShadowDepth="5"
                              Opacity="0.12"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:DashboardToggle Grid.Row="0"/>

            <Grid Grid.Row="2">

                <controls:ChartsPanel>
                    <controls:ChartsPanel.Style>
                        <Style TargetType="controls:ChartsPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChartsMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:ChartsPanel.Style>
                </controls:ChartsPanel>

                <controls:ActivityTimelinePanel>
                    <controls:ActivityTimelinePanel.Style>
                        <Style TargetType="controls:ActivityTimelinePanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTimelineMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:ActivityTimelinePanel.Style>
                </controls:ActivityTimelinePanel>

                <controls:SessionSummaryPanel>
                    <controls:SessionSummaryPanel.Style>
                        <Style TargetType="controls:SessionSummaryPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSummaryMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:SessionSummaryPanel.Style>
                </controls:SessionSummaryPanel>

                <controls:AppCategoryRulesPanel>
                    <controls:AppCategoryRulesPanel.Style>
                        <Style TargetType="controls:AppCategoryRulesPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCategoriesMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:AppCategoryRulesPanel.Style>
                </controls:AppCategoryRulesPanel>

                <controls:SessionHistoryPanel>
                    <controls:SessionHistoryPanel.Style>
                        <Style TargetType="controls:SessionHistoryPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:SessionHistoryPanel.Style>
                </controls:SessionHistoryPanel>

            </Grid>

        </Grid>

    </Border>

</UserControl>
