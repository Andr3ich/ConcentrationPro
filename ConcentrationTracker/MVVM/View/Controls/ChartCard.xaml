<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>

                <TextBlock Text="{DynamicResource ChartCard_Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>

                <TextBlock Text="{DynamicResource ChartCard_Subtitle}"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}"/>

            </StackPanel>

            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="20">

                <Canvas>

                    <Line X1="0" Y1="40" X2="700" Y2="40"
                          Stroke="#E2E8F0"
                          StrokeThickness="1"/>

                    <Line X1="0" Y1="90" X2="700" Y2="90"
                          Stroke="#E2E8F0"
                          StrokeThickness="1"/>

                    <Line X1="0" Y1="140" X2="700" Y2="140"
                          Stroke="#E2E8F0"
                          StrokeThickness="1"/>

                    <Polyline Stroke="{StaticResource AccentBlue}"
                              StrokeThickness="3"
                              Points="
                              20,140
                              100,100
                              180,120
                              260,70
                              340,90
                              420,50
                              500,85
                              580,40"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="15"
         Canvas.Top="135"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="95"
         Canvas.Top="95"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="175"
         Canvas.Top="115"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="255"
         Canvas.Top="65"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="335"
         Canvas.Top="85"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="415"
         Canvas.Top="45"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="495"
         Canvas.Top="80"/>

                    <Ellipse Width="10"
         Height="10"
         Fill="{StaticResource AccentBlue}"
         Canvas.Left="575"
         Canvas.Top="35"/>

                </Canvas>

            </Border>

            <UniformGrid Grid.Row="3"
                         Columns="8"
                         Margin="0,12,0,0">

                <TextBlock Text="09:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="10:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="11:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="12:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="13:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="14:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="15:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <TextBlock Text="16:00"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

            </UniformGrid>

        </Grid>

    </Border>

</UserControl>
