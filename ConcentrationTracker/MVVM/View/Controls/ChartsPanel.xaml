<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.ChartsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ConcentrationTracker.MVVM.View.Controls">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="24">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock Text="{DynamicResource Charts_WindowSwitchingTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="{DynamicResource Charts_WindowSwitchingSubtitle}"
                               FontSize="14"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                </StackPanel>

                <controls:ThemedPlotView Grid.Row="2"
                                          Model="{Binding SwitchesPlotModel}"
                                          Background="Transparent"/>

            </Grid>

        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSoftBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="24">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                    <TextBlock Text="{DynamicResource Charts_ScoreTitle}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="{DynamicResource Charts_ScoreSubtitle}"
                               FontSize="14"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                </StackPanel>

                <controls:ThemedPlotView Grid.Row="2"
                                          Model="{Binding ScorePlotModel}"
                                          Background="Transparent"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>