<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.KpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="20"
            Margin="0,0,12,0">

        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                              BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.10"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="16"
                    Background="{Binding IconBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalAlignment="Top">

                <iconPacks:PackIconMaterial Kind="{Binding IconKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Width="23"
                                            Height="23"
                                            Foreground="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
