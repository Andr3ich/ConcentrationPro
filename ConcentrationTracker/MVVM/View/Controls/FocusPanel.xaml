<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.FocusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ConcentrationTracker.MVVM.View.Controls"
             xmlns:converters="clr-namespace:ConcentrationTracker.Core.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <UserControl.Resources>
        <converters:ActivityIconResolverConverter x:Key="ActivityIconResolverConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="22">

        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}"
                              BlurRadius="22"
                              ShadowDepth="5"
                              Opacity="0.12"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconMaterial Kind="Target"
                                            Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Focus_Title}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

            </Grid>

            <controls:CircularScore Grid.Row="2"
                                    Score="{Binding ConcentrationScore}"
                                    Width="200"
                                    Height="200"
                                    HorizontalAlignment="Center"/>

            <Border Grid.Row="4"
                    Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Width="52"
                            Height="52"
                            CornerRadius="16"
                            Background="{DynamicResource AccentUltraSoftBrush}"
                            VerticalAlignment="Top">

                        <Grid>

                            <Image Width="30"
                                   Height="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}">
                                        <Binding Path="CurrentApp"/>
                                        <Binding Path="CurrentWindowTitle"/>
                                        <Binding Path="CurrentProcessPath"/>
                                        <Binding Path="CurrentPackageInstallPath"/>
                                        <Binding Path="CurrentAppUserModelId"/>
                                        <Binding Path="CurrentPackageFullName"/>
                                    </MultiBinding>
                                </Image.Source>
                                <Image.Visibility>
                                    <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}"
                                                  ConverterParameter="HasIcon">
                                        <Binding Path="CurrentApp"/>
                                        <Binding Path="CurrentWindowTitle"/>
                                        <Binding Path="CurrentProcessPath"/>
                                        <Binding Path="CurrentPackageInstallPath"/>
                                        <Binding Path="CurrentAppUserModelId"/>
                                        <Binding Path="CurrentPackageFullName"/>
                                    </MultiBinding>
                                </Image.Visibility>
                            </Image>

                            <iconPacks:PackIconMaterial Kind="Application"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial.Visibility>
                                    <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}"
                                                  ConverterParameter="NoIcon">
                                        <Binding Path="CurrentApp"/>
                                        <Binding Path="CurrentWindowTitle"/>
                                        <Binding Path="CurrentProcessPath"/>
                                        <Binding Path="CurrentPackageInstallPath"/>
                                        <Binding Path="CurrentAppUserModelId"/>
                                        <Binding Path="CurrentPackageFullName"/>
                                    </MultiBinding>
                                </iconPacks:PackIconMaterial.Visibility>
                            </iconPacks:PackIconMaterial>

                        </Grid>

                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                        <TextBlock Text="{DynamicResource Focus_CurrentActivity}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Text="{Binding CurrentAppDisplay}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>

                        <Grid Margin="0,5,0,0"
                              MaxHeight="74">

                            <TextBlock Text="{Binding CurrentWindowTitle}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentApp}" Value="Dashboard">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentApp}" Value="Idle">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{DynamicResource Focus_DashboardExcluded}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentApp}" Value="Dashboard">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{DynamicResource Focus_AwaySavedSeparately}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentApp}" Value="Idle">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </Grid>

                    </StackPanel>

                </Grid>

            </Border>

            <Border Grid.Row="6"
                    Background="{DynamicResource SurfaceSoftBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="15">

                <StackPanel>

                    <TextBlock Text="{DynamicResource Focus_Summary}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource Focus_LastBlock}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastFocusBlock}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Border Height="1"
                            Background="{DynamicResource DividerBrush}"
                            Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource Focus_BestBlock}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding BestFocusBlock}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Border Height="1"
                            Background="{DynamicResource DividerBrush}"
                            Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource Focus_Interruptions}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding InterruptionCount}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                </StackPanel>

            </Border>

            <StackPanel Grid.Row="8">

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Focus_Quality}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DeepFocusPercent}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <Grid Height="12"
                      Margin="0,0,0,14">

                    <Border Background="{DynamicResource BorderSoftBrush}"
                            CornerRadius="6"/>

                    <Border Background="{DynamicResource AccentBrush}"
                            Width="{Binding DeepFocusBarWidth}"
                            HorizontalAlignment="Left"
                            CornerRadius="6"/>

                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Focus_Stability}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DistractionControlPercent}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <Grid Height="12">

                    <Border Background="{DynamicResource BorderSoftBrush}"
                            CornerRadius="6"/>

                    <Border Background="{DynamicResource ProductiveBrush}"
                            Width="{Binding DistractionBarWidth}"
                            HorizontalAlignment="Left"
                            CornerRadius="6"/>

                </Grid>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
