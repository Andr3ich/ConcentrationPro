<UserControl x:Class="ConcentrationTracker.MVVM.View.Controls.CurrentActivityCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ConcentrationTracker.Core.Converters">

    <UserControl.Resources>

        <converters:ActivityIconResolverConverter
            x:Key="ActivityIconResolverConverter"/>

        <converters:AppCategoryToIconGlyphConverter
            x:Key="AppCategoryToIconGlyphConverter"/>

        <converters:AppCategoryToLightBrushConverter
            x:Key="AppCategoryToLightBrushConverter"/>

        <converters:AppCategoryToBrushConverter
            x:Key="AppCategoryToBrushConverter"/>

        <converters:AppNameDisplayConverter
            x:Key="AppNameDisplayConverter"/>

        <converters:WindowTitleCleanerConverter
            x:Key="WindowTitleCleanerConverter"/>

    </UserControl.Resources>

    <Border Background="#F8FAFC"
            CornerRadius="16"
            Padding="16"
            Margin="0,0,0,22">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="46"
                    Height="46"
                    CornerRadius="14"
                    Background="{Binding CurrentCategory,
                                         Converter={StaticResource AppCategoryToLightBrushConverter}}">

                <Grid>

                    <Image Width="28"
                           Height="28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                        <Image.Source>
                            <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}">
                                <Binding Path="CurrentApp"/>
                                <Binding Path="CurrentWindowTitle"/>
                                <Binding Path="CurrentProcessPath"/>
                                <Binding Path="CurrentPackageInstallPath"/>
                                <Binding Path="CurrentAppUserModelId"/>
                                <Binding Path="CurrentPackageFullName"/>
                                <Binding Path="CurrentCategory"/>
                            </MultiBinding>
                        </Image.Source>

                        <Image.Visibility>
                            <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}"
                                          ConverterParameter="HasIcon">
                                <Binding Path="CurrentApp"/>
                                <Binding Path="CurrentWindowTitle"/>
                                <Binding Path="CurrentProcessPath"/>
                                <Binding Path="CurrentPackageInstallPath"/>
                                <Binding Path="CurrentAppUserModelId"/>
                                <Binding Path="CurrentPackageFullName"/>
                                <Binding Path="CurrentCategory"/>
                            </MultiBinding>
                        </Image.Visibility>

                    </Image>

                    <TextBlock Text="{Binding CurrentCategory,
                                              Converter={StaticResource AppCategoryToIconGlyphConverter}}"
                               FontSize="20"
                               FontFamily="Segoe UI Emoji, Segoe UI"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{Binding CurrentCategory,
                                                    Converter={StaticResource AppCategoryToBrushConverter}}">

                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource ActivityIconResolverConverter}"
                                          ConverterParameter="NoIcon">
                                <Binding Path="CurrentApp"/>
                                <Binding Path="CurrentWindowTitle"/>
                                <Binding Path="CurrentProcessPath"/>
                                <Binding Path="CurrentPackageInstallPath"/>
                                <Binding Path="CurrentAppUserModelId"/>
                                <Binding Path="CurrentPackageFullName"/>
                                <Binding Path="CurrentCategory"/>
                            </MultiBinding>
                        </TextBlock.Visibility>

                    </TextBlock>

                </Grid>

            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">

                <TextBlock Text="{DynamicResource Focus_CurrentActivity}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"/>

                <TextBlock Text="{Binding CurrentApp,
                                          Converter={StaticResource AppNameDisplayConverter}}"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock FontSize="12"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis">

                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource WindowTitleCleanerConverter}">
                            <Binding Path="CurrentWindowTitle"/>
                            <Binding Path="CurrentApp"/>
                        </MultiBinding>
                    </TextBlock.Text>

                </TextBlock>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
